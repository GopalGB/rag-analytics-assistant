# Environment for the hosted PUBLIC DEMO on Vercel (Project → Settings → Environment Variables).
# Values in <angle brackets> are secrets: paste them into Vercel's encrypted settings, never into git.
# Check before deploying:  set these in your shell, then  make preflight TARGET=public-demo
PUBLIC_DEMO=true
DB_PATH=:memory:
STORAGE_DIR=/tmp/assistant
AUTO_REINDEX=false
EMBEDDING_PROVIDER=local
ALLOW_CLOUD_AI=true
GROQ_API_KEY=<your Groq key>
# A fallback chain: each free-tier model has its own quota.
LLM_MODELS_STRONG=groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b,groq:qwen/qwen3.8-27b
LLM_MODELS_FAST=groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b,groq:qwen/qwen3.8-27b
# Rules extraction reads every sample invoice; the AI pass would only slow cold starts.
INVOICE_AI_ASSIST=false
# Pre-generated answers to the suggested questions (scripts/build_answer_cache.py).
ANSWER_CACHE_SEED=data/demo_answer_cache.json
# Synthetic + public data only, so every class may go to the hosted model. Never use this with company data.
CLOUD_ALLOWED_DATA=documents,invoices,accounting,bank
REDACT_PII=true
APP_API_KEY=<long random string; the Worker's ORIGIN_API_KEY secret must be the same value>
TRUST_LOOPBACK=false
ALLOWED_HOSTS=<your-project>.vercel.app
ALLOWED_ORIGINS=https://<your-domain>
REPORT_AS_OF=2026-07-15
LOG_FORMAT=json
