# Copy to .env and fill in.
#   cp env.example .env
# This assistant is LLM-first: you MUST configure exactly one provider below (Option A/B/C) or the
# app refuses to start. Everything else has sensible defaults.

# --- App ---
# APP_NAME=RAG Analytics Assistant
# DATA_DIR=data/sample
# DB_PATH=storage/analytics.duckdb

# --- HTTP security ---
# APP_API_KEY=                 # if set, non-public routes require this key
# TRUST_LOOPBACK=true          # set false behind a reverse proxy so the key is always required
# RATE_PER_MINUTE=60
# RATE_BURST=20
# MAX_BODY_BYTES=65536
# MAX_INPUT_CHARS=2000

# --- LLM (REQUIRED — pick ONE of Option A / B / C below) ---
# LLM_PROVIDER=auto            # auto | openai | bedrock | cli | none
# REQUIRE_LLM=true             # set false to boot without a model (it will refuse to answer)
#
# Option A — OpenAI (or any OpenAI-compatible /chat/completions endpoint)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini     # set to a model you actually have access to
#
# Option B — AWS Bedrock (pip install boto3; uses your standard AWS credentials)
# BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
# AWS_REGION=us-east-1
#
# Option C — local CLI (e.g. the ChatGPT / Codex CLI on your existing subscription).
# The command must read the prompt on stdin and write the completion to stdout.
# LLM_CLI_COMMAND=codex exec -
# LLM_CLI_TIMEOUT=120

# --- Embeddings (vectorization; defaults to local — no model download or API key) ---
# EMBEDDING_PROVIDER=auto      # auto | openai | local
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# LOCAL_EMBEDDING_DIM=256

# --- Auto-ingest (drop files into DATA_DIR; they are embedded + indexed automatically) ---
# AUTO_REINDEX=true
# REINDEX_INTERVAL_SECONDS=5

# --- Agent loop ---
# MAX_TOOL_ITERATIONS=4
# MAX_SQL_ROWS=200
# HISTORY_TURNS=8
