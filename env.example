# Copy to .env and adjust.   cp env.example .env
# Every setting is optional: the defaults run fully offline with the bundled synthetic data.

# --- App ---
# APP_NAME=Private AI Assistant
# DATA_DIR=data/sample            # folder of documents / invoices / spreadsheets (scanned recursively)
# STORAGE_DIR=storage             # local state: database, caches, reviews, approvals, activity log
# DB_PATH=storage/assistant.duckdb

# --- Access ---
# APP_API_KEY=                    # if set, requests from other machines must send X-API-Key
# TRUST_LOOPBACK=true             # set false behind a reverse proxy so the key is always required
# ALLOWED_HOSTS=127.0.0.1,localhost,::1   # Host names the server answers to; add the Mac's LAN name/IP or the demo domain
# ALLOWED_ORIGINS=                # extra browser origins allowed to POST (a proxy in front of a hosted demo)
# SQL_TIMEOUT_SECONDS=2           # model/user SQL is interrupted after this long
# DB_MEMORY_LIMIT=512MB
# PUBLIC_DEMO=false               # true = read-only, stateless hosted demo (synthetic data only; see docs/DEPLOYMENT.md)

# --- AI models (full guide: docs/LLM-ROUTING.md) ---
# Add ANY of the API keys below; only providers with a key are used. Cloud use needs owner approval:
# ALLOW_CLOUD_AI=true
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1   # a localhost/LAN URL (LM Studio, vLLM) counts as local
# OPENAI_MODEL=gpt-4o-mini                    # openai fast-tier default
# OPENAI_MODEL_STRONG=gpt-4o                  # openai strong-tier default
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# DEEPSEEK_API_KEY=
# TOGETHER_API_KEY=
# XAI_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# BEDROCK_MODEL_ID=                           # + AWS credentials, pip install boto3
# LLM_CLI_COMMAND=                            # any CLI: prompt on stdin, answer on stdout
# LLM_CLI_IS_LOCAL=false

# Local models (Ollama)
# OLLAMA_MODEL=qwen2.5:14b
# OLLAMA_MODEL_STRONG=qwen2.5:32b
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# LOCAL_MODEL_HOSTS=                # extra model-server host names to treat as local (e.g. ollama in docker compose)

# Model router: fallback chains per tier (provider:model, comma-separated). Empty = built from keys.
# LLM_MODELS_FAST=anthropic:claude-haiku-4-5-20251001,openai:gpt-4o-mini,ollama:qwen2.5:14b
# LLM_MODELS_STRONG=anthropic:claude-sonnet-5,openai:gpt-4o,ollama:qwen2.5:32b
# LLM_PREFER=cloud                            # cloud | local — default order when chains are derived
# LLM_PROVIDER=auto                           # or pin a single provider, or none
# ROUTER_FAILURE_THRESHOLD=3                  # circuit breaker
# ROUTER_COOLDOWN_SECONDS=60
# LLM_PRICING={"anthropic:claude-sonnet-5": [3, 15]}   # USD per million input/output tokens (for cost tracking)
# INTENT_MODEL_FALLBACK=true                  # ask the fast model when keyword routing is unsure
# PREFETCH_PASSAGES=4
# REQUIRE_LLM=false

# Privacy router
# CLOUD_ALLOWED_DATA=documents                # documents,invoices,accounting,bank,personal
# REDACT_PII=true                             # mask emails / phones / account numbers sent to cloud models
# SENSITIVE_PATHS=hr/=personal,payroll/=personal

# --- Documents ---
# OCR_ENABLED=true                # needs `brew install tesseract`
# OCR_LANG=eng
# DATE_ORDER=MDY                  # how to read ambiguous dates like 05/06/2026 (always flagged for review)
# INVOICE_AI_ASSIST=true          # also ask the AI model to read invoices (only grounded values accepted)

# --- Search ---
# EMBEDDING_PROVIDER=auto         # auto = Ollama's embedding model if reachable, else offline hashing | local | ollama | openai
# EMBEDDING_MODEL=                # default nomic-embed-text (ollama) / text-embedding-3-small (openai)
# EMBEDDING_BASE_URL=             # default OLLAMA_BASE_URL / OPENAI_BASE_URL; a localhost URL counts as local
# EMBEDDING_API_KEY=
# ALLOW_CLOUD_EMBEDDINGS=false    # cloud embeddings send document text out; needs ALLOW_CLOUD_AI too
# RERANK_WITH_MODEL=false         # reorder search hits with a LOCAL model (better order, slower)

# --- Reports ---
# REPORT_AS_OF=                   # YYYY-MM-DD for aging / overdue figures (default: today). `make demo` sets 2026-07-15.

# --- Logs & monitoring ---
# LOG_LEVEL=INFO
# LOG_FORMAT=json                 # json (one object per line, with request_id) | text
# METRICS_ENABLED=true            # Prometheus text at /metrics

# --- QuickBooks Online (read-only) ---
# QBO_MODE=mock                   # mock = offline test company | sandbox = live Intuit sandbox | off
# QBO_CLIENT_ID=                  # from developer.intuit.com (sandbox app keys) — see docs/QUICKBOOKS.md
# QBO_CLIENT_SECRET=
# QBO_REDIRECT_URI=http://localhost:8000/qbo/callback
# SECRETS_BACKEND=file            # file (0600) | keyring (macOS Keychain; pip install keyring)

# --- Auto-ingest ---
# AUTO_REINDEX=true
# REINDEX_INTERVAL_SECONDS=5
