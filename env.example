# Copy to .env and fill in. Everything is optional — the app runs offline with sensible defaults.
#   cp env.example .env

# --- App ---
# APP_NAME=RAG Analytics Assistant
# DATA_DIR=data/sample
# DB_PATH=storage/analytics.duckdb

# --- HTTP security ---
# APP_API_KEY=                 # if set, non-public routes require this key
# TRUST_LOOPBACK=true          # set false behind a reverse proxy so the key is always required
# RATE_PER_MINUTE=60
# RATE_BURST=20
# MAX_BODY_BYTES=65536
# MAX_INPUT_CHARS=2000

# --- LLM (optional; without a key the app uses its deterministic fallback) ---
# LLM_PROVIDER=auto            # auto | openai | none
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini     # set to a model you actually have access to

# --- Embeddings ---
# EMBEDDING_PROVIDER=auto      # auto | openai | local
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# LOCAL_EMBEDDING_DIM=256

# --- Agent loop ---
# MAX_TOOL_ITERATIONS=4
# MAX_SQL_ROWS=200
# HISTORY_TURNS=8
